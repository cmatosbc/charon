{
    "name": "cmatosbc/charon",
    "description": "PSR-15 rate limiting middleware: fixed window and token bucket throttling with PSR-16 storage",
    "type": "library",
    "keywords": [
        "rate limiting",
        "rate limiter",
        "throttling",
        "throttle",
        "middleware",
        "psr-15",
        "psr-7",
        "psr-16",
        "token bucket",
        "fixed window",
        "http",
        "api"
    ],
    "autoload": {
        "psr-4": {
            "Charon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Charon\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "psr/clock": "^1.0",
        "psr/simple-cache": "^3.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^11.4"
    },
    "scripts": {
        "test": "phpunit"
    },
    "license": "gpl-3.0-or-later",
    "authors": [
        {
            "name": "Carlos Matos",
            "email": "carlosarturmatos1977@gmail.com"
        }
    ],
    "minimum-stability": "stable"
}
